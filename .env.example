# URL base de la API REST (sin barra final). Incluye prefijos como /api si tu backend los usa.
# Ejemplo: http://localhost:3000  o  https://mi-servidor.com/api/v1
VITE_API_BASE_URL=http://localhost:3000

# Tope por archivo en MB para el dropzone de adjuntos (default 4). Debe coincidir
# con MAX_UPLOAD_SIZE_MB del backend: aquí sólo se pre-valida antes de subir.
VITE_MAX_UPLOAD_SIZE_MB=4
